# --- Engine (Cursor primary) -------------------------------------------------
# Agent turns run on the Cursor subscription by default. Set to `claude` to
# spend Max-plan instead, or `hybrid` for Cursor prose + Claude on plan/decide.
AGORA_DRIVER=cursor
CURSOR_BIN=/home/dominickooya/.local/bin/cursor-agent
# Fallback / force model. `auto` = subscription seat for ALL turns (no API
# spend). Specific ids (claude-opus-5-high, etc.) burn Pro+ usage limits.
AGORA_CURSOR_MODEL=auto
AGORA_CURSOR_PLAN_MODEL=auto

# --- Claude engine (used when AGORA_DRIVER=claude or hybrid orchestrator) -----
# Path to the Claude Code CLI. Runs on your Max-plan OAuth; no API key needed.
CLAUDE_BIN=/home/dominickooya/.local/bin/claude

# Default model + effort for agents that don't override in their .md frontmatter
# under the Claude driver. Aliases (opus/sonnet/fable) or full ids (claude-opus-5).
AGORA_MODEL=claude-sonnet-5
AGORA_EFFORT=low

# --- Run safety --------------------------------------------------------------
# Hard caps. These are the real cost control - a subscription has no $ ceiling.
# Turns between progress reviews. NOT a hard stop - the room keeps working
# until the goal is met or it is genuinely blocked.
AGORA_MAX_TURNS=12
# Review rounds a run may pass before it is stopped regardless of verdict.
AGORA_MAX_ROUNDS=6
# A review also fires on the clock, so one long turn still reports in.
AGORA_REVIEW_EVERY_MS=600000
# Backstop for the whole run. Generous on purpose: a browser sweep doing real
# work takes many minutes, and killing it for that throws away everything it did.
AGORA_RUN_TIMEOUT_MS=5400000
# One agent turn. Exceeding it fails that turn, not the run.
AGORA_TURN_TIMEOUT_MS=300000
# Concurrent `claude` processes across the whole server. Max-plan rate limits
# are shared with your normal Claude Code use, so keep this low. This also
# caps how many agents of a parallel wave actually run at the same time.
AGORA_MAX_CONCURRENCY=2
# Steps whose dependencies are done start together, each with its own owner.
# 0 = one agent per orchestrator turn, as before.
AGORA_PARALLEL_STEPS=1
# How many recent messages to replay into each agent turn.
AGORA_TRANSCRIPT_WINDOW=40
# Rewrite a reply once on the cheap model when it runs past the house length
# budget (protocol.ts REPLY_LIMITS). 0 = post long replies as they are.
AGORA_LENGTH_GUARD=1
# Dollars one run may spend before it stops and asks Dominic to press Resume.
# 0 disables. Research turns (WebSearch/WebFetch) are the expensive kind.
AGORA_GOAL_COST_CAP_USD=5
# How many agents an orchestrator may forge per goal, and how many forged
# agents a room may hold. Templates live in templates/agents/.
AGORA_MAX_SPAWNS_PER_GOAL=3
AGORA_MAX_FORGED_PER_ROOM=12

# --- WhatsApp notify hop -----------------------------------------------------
OPENCLAW_BIN=/home/dominickooya/.npm-global/bin/openclaw
# Leave EMPTY to disable sending entirely (notifications are logged, not sent).
# Set to a group JID to go live, e.g. 120363411293585423@g.us
AGORA_NOTIFY_JID=
# true = compose and log the command but never execute it.
AGORA_NOTIFY_DRY_RUN=true
# Minimum seconds between two notifications from the same room.
AGORA_NOTIFY_MIN_INTERVAL_S=60

# --- Browser QA (agents with `mcp: ["chrome-devtools"]`) ----------------------
# Needs a Chrome listening on CDP: scripts/start-chrome.sh
# Credentials are injected into the agent's prompt at runtime and are never
# written into an agent's .md, so those files stay safe to read and share.
# NOTE: quote any value containing '#', or .env parsing treats it as a comment
# and silently truncates the value.
AGORA_QA_BASE_URL=
AGORA_QA_ADMIN_URL=
AGORA_QA_EMAIL=
AGORA_QA_PASSWORD=
# The only account agents may enter.
AGORA_QA_ACCOUNT=
AGORA_CDP_PORT=9222

# --- Server ------------------------------------------------------------------
AGORA_PORT=8787
# Binds the WSL VM interface so Windows can reach it. The VM is on a host-only
# NAT network, so this is not exposed to your LAN. Use 127.0.0.1 to lock it down
# to inside WSL only.
AGORA_HOST=0.0.0.0

# --- Per-room WhatsApp targets -------------------------------------------
# Overrides AGORA_NOTIFY_JID for ONE room, keyed by the slugified room NAME
# (same slug that picks the room rules file). Value `off` silences that room.
# Empty or unset falls back to the global AGORA_NOTIFY_JID above, so never use
# an empty value to mean off.
#AGORA_NOTIFY_JID_VOICEMAIL_DETECTION=1203634...@g.us

# How much a room says on WhatsApp, keyed by the slugified room NAME the same
# way AGORA_NOTIFY_JID_* is.
#   all    - everything: progress notifies, answers, discussion digests, the
#            full end-of-run report.
#   prompt - only the two kinds that ask something of Dominic: the finished
#            Claude prompt, and a blocked room needing a decision. In this mode
#            the end-of-run report collapses to the prompt itself, and a goal
#            that produced no prompt sends nothing at all.
AGORA_NOTIFY_LEVEL=all
AGORA_NOTIFY_LEVEL_HELLOALEX_AGORA=prompt
