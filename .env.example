# --- Claude engine -----------------------------------------------------------
# Path to the Claude Code CLI. Runs on your Max-plan OAuth; no API key needed.
CLAUDE_BIN=/home/dominickooya/.local/bin/claude

# Default model + effort for agents that don't override in their .md frontmatter.
# Aliases (opus/sonnet/fable) or full ids (claude-opus-5).
AGORA_MODEL=claude-sonnet-5
AGORA_EFFORT=low

# --- Run safety --------------------------------------------------------------
# Hard caps. These are the real cost control - a subscription has no $ ceiling.
AGORA_MAX_TURNS=12
# Backstop for the whole run. Generous on purpose: a browser sweep doing real
# work takes many minutes, and killing it for that throws away everything it did.
AGORA_RUN_TIMEOUT_MS=2700000
# One agent turn. Exceeding it fails that turn, not the run.
AGORA_TURN_TIMEOUT_MS=300000
# Concurrent `claude` processes across the whole server. Max-plan rate limits
# are shared with your normal Claude Code use, so keep this low.
AGORA_MAX_CONCURRENCY=2
# How many recent messages to replay into each agent turn.
AGORA_TRANSCRIPT_WINDOW=40

# --- WhatsApp notify hop -----------------------------------------------------
OPENCLAW_BIN=/home/dominickooya/.npm-global/bin/openclaw
# Leave EMPTY to disable sending entirely (notifications are logged, not sent).
# Set to a group JID to go live, e.g. 120363411293585423@g.us
AGORA_NOTIFY_JID=
# true = compose and log the command but never execute it.
AGORA_NOTIFY_DRY_RUN=true
# Minimum seconds between two notifications from the same room.
AGORA_NOTIFY_MIN_INTERVAL_S=60

# --- Browser QA (agents with `mcp: ["chrome-devtools"]`) ----------------------
# Needs a Chrome listening on CDP: scripts/start-chrome.sh
# Credentials are injected into the agent's prompt at runtime and are never
# written into an agent's .md, so those files stay safe to read and share.
# NOTE: quote any value containing '#', or .env parsing treats it as a comment
# and silently truncates the value.
AGORA_QA_BASE_URL=
AGORA_QA_ADMIN_URL=
AGORA_QA_EMAIL=
AGORA_QA_PASSWORD=
# The only account agents may enter.
AGORA_QA_ACCOUNT=
AGORA_CDP_PORT=9222

# --- Server ------------------------------------------------------------------
AGORA_PORT=8787
# Binds the WSL VM interface so Windows can reach it. The VM is on a host-only
# NAT network, so this is not exposed to your LAN. Use 127.0.0.1 to lock it down
# to inside WSL only.
AGORA_HOST=0.0.0.0
